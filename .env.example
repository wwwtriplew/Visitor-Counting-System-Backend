# Visitor Counting System Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: Supabase Configuration
# ============================================================================

# Your Supabase project URL
# Find this in your Supabase project settings under "API" section
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase service role key (SECRET - keep this secure!)
# Find this in your Supabase project settings under "API" section
# This key bypasses Row Level Security and should ONLY be used on the backend
# NEVER expose this key in client-side code or public repositories
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ============================================================================
# OPTIONAL: Model Configuration
# ============================================================================

# Path to YOLO model weights file
# Can be a local file path or a model name that will be downloaded
# Options: yolov8n.pt (nano - fastest), yolov8s.pt (small), yolov8m.pt (medium)
# Default: yolov8n.pt
# YOLO_MODEL_PATH=yolov8n.pt

# ============================================================================
# OPTIONAL: Database Configuration
# ============================================================================

# Name of the Supabase table for storing visitor counts
# Default: detections
# TABLE_NAME=detections

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Security:
#    - Never commit the actual .env file to version control
#    - Keep your SUPABASE_SERVICE_KEY secret
#    - Use different keys for development and production
#
# 2. Model Selection:
#    - yolov8n.pt: Fastest, smallest model (~6MB) - good for real-time
#    - yolov8s.pt: Balanced speed and accuracy (~22MB)
#    - yolov8m.pt: Better accuracy, slower (~52MB)
#
# 3. First Run:
#    - The YOLO model will be downloaded automatically on first use
#    - Ensure you have internet connection for the initial download
#    - The model is cached locally for subsequent runs
#
# 4. Validation:
#    - All environment variables are validated on startup
#    - Missing required variables will cause the application to fail with a clear error
#    - Invalid URLs or keys will be caught before processing begins
#

